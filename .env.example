# ─────────────────────────────────────────────────────────────
#  live-interpreter — environment configuration
#  Copy this file to `.env` and fill in the values.
#  NEVER commit your real .env. The Gemini key stays server-side only.
# ─────────────────────────────────────────────────────────────

# --- Gemini (Google AI Studio) ---
# Get one at https://aistudio.google.com/apikey  (free tier available)
GEMINI_API_KEY=your-gemini-api-key-here

# --- LiveKit Cloud ---
# Create a free project at https://cloud.livekit.io
# Then: Settings -> Keys -> create a key. Copy all three values below.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Server ---
PORT=8080
# Public origin the share link/QR should point at.
# Local demo with a tunnel: set this to your https tunnel URL (e.g. https://abc.ngrok-free.app)
# Cloud deploy: set to your deployed URL (e.g. https://live-interpreter.onrender.com)
PUBLIC_BASE_URL=http://localhost:8080

# --- Model IDs (override here if Google ships newer revisions) ---
# Streaming STT over the Live API. Must be a half-cascade model that supports
# TEXT output + input transcription (native-audio models are AUDIO-only and fail).
STT_MODEL=gemini-3.1-flash-live-preview
# Text interpreter step (meaning-based re-expression). Use a flash model for lower latency/cost.
INTERPRET_MODEL=gemini-3.1-pro-preview
# Text-to-speech. Expressive, 70+ languages, audio-tag control.
TTS_MODEL=gemini-3.1-flash-tts-preview
# Direct audio-to-audio Live Translate, used ONLY for the A/B comparison toggle.
LIVE_TRANSLATE_MODEL=models/gemini-3.5-live-translate-preview

# --- Pipeline tuning ---
# Languages students can pick (comma-separated BCP-47-ish codes; must exist in server/config.js).
LISTENER_LANGUAGES=en,te,ta,kn,hi,ml
# Default voice name passed to the TTS model (a warm, mid-energy voice).
TTS_VOICE=Charon
# How much transcript context (chars) to keep for interpreter coherence across chunks.
INTERPRET_CONTEXT_CHARS=600
